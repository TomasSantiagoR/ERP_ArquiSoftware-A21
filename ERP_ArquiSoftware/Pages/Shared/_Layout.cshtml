@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Auth
@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;

    // ¡User! para evitar warnings de nullability cuando estás autenticado!
    var canVentas = isAuth && (await Auth.AuthorizeAsync(User!, "Ventas")).Succeeded;
    var canInvRead = isAuth && (await Auth.AuthorizeAsync(User!, "Inventario.Read")).Succeeded;
    var canRRHH = isAuth && (await Auth.AuthorizeAsync(User!, "RRHH")).Succeeded;

    // Contador de notificaciones no leídas (opcional)
    var notifCountObj = ViewData["NotifCount"];
    int? notifCount = notifCountObj is int c ? c : null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ERP_ArquiSoftware</title>

    <!-- Remix Icon CDN -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet">

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;400;700&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- CSS del proyecto -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ERP_ArquiSoftware.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <style>
        /* Posicionar badge sobre el ícono del navbar de forma linda */
        .nav-icon {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.25rem;
            height: 2.25rem;
            border-radius: 50%;
        }

            .nav-icon:hover {
                background: rgba(0,0,0,.05);
            }

        .notif-badge {
            position: absolute;
            top: 0;
            right: 0;
            transform: translate(35%,-35%);
        }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    <i class="ri-dashboard-line"></i> <span>ERP_ArquiSoftware</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- Menú centrado controlado por políticas -->
                    <ul class="navbar-nav mx-auto">
                        @if (canVentas)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Ventas/Clientes/Home">Ventas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Facturacion/Facturas/Index">Facturación</a>
                            </li>
                        }
                        @if (canRRHH)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/RRHH/Home">RRHH</a>
                            </li>
                        }
                        @if (canInvRead)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Inventario/HomeInv">Inventario</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Maestros/Almacenes/Index">Almacenes</a>
                            </li>
                        }
                        @* Proveedores: si deseas, crea una policy y la aplicas igual *@
                        @if (isAuth)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Proveedores/HomeProv">Proveedores</a>
                            </li>
                        }
                    </ul>

                    <!-- Íconos + Login/Logout a la derecha -->
                    <ul class="navbar-nav ms-auto align-items-center">

                        @* Campana de notificaciones (solo autenticado) *@
                        @if (isAuth)
                        {
                            <li class="nav-item me-1">
                                <a class="nav-link nav-icon" asp-area="" asp-page="/Notificaciones/Index" title="Notificaciones">
                                    <i class="ri-notification-3-line"></i>
                                    @if (notifCount.HasValue && notifCount.Value > 0)
                                    {
                                        <span class="badge rounded-pill text-bg-danger notif-badge">
                                            @((notifCount.Value > 99) ? "99+" : notifCount.Value.ToString())
                                        </span>
                                    }
                                </a>
                            </li>
                        }

                        @if (isAuth)
                        {
                            <li class="nav-item d-none d-sm-block">
                                <span class="nav-link">Hola, @User!.Identity!.Name</span>
                            </li>
                            <li class="nav-item">
                                <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" method="post">
                                    <button type="submit" class="btn btn-link nav-link">Salir</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Ingresar</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid d-flex min-vh-100">
        <div class="d-flex flex-grow-1">
            <aside class="erp-sidebar">
                @await Html.PartialAsync("_SideMenu")
            </aside>

            <main class="flex-grow-1 py-3 px-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - ERP_ArquiSoftware - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


