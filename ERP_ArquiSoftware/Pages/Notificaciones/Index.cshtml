@page
@model ERP_ArquiSoftware.Pages.Notificaciones.IndexModel
@{
    ViewData["Title"] = "Notificaciones";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h3 class="m-0">@ViewData["Title"]</h3>

    <div class="d-flex gap-2">
        <form method="post" asp-page-handler="MarkAllRead" class="d-inline">
            @Html.AntiForgeryToken()
            <button class="btn btn-sm btn-success"
                    @(Model.Items.Any(i => !i.Leida) ? "" : "disabled")>
                Marcar todas como leídas
            </button>
        </form>

        <!-- NUEVO: borrar todas -->
        <form method="post" asp-page-handler="DeleteAll" class="d-inline"
              onsubmit="return confirm('¿Eliminar TODAS las notificaciones? Esta acción no se puede deshacer.');">
            @Html.AntiForgeryToken()
            <button class="btn btn-sm btn-danger"
                    @(Model.Items.Any() ? "" : "disabled")>
                Eliminar todas
            </button>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive" style="max-height: 65vh; overflow:auto;">
        <table class="table table-hover align-middle m-0">
            <thead class="table-light sticky-top">
                <tr>
                    <th style="width: 110px;">Fecha</th>
                    <th>Título</th>
                    <th>Mensaje</th>
                    <th style="width: 120px;">Tipo</th>
                    <th style="width: 120px;">Estado</th>
                    <th style="width: 160px;" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var n in Model.Items)
                    {
                        <tr class="@(n.Leida ? "" : "table-warning")">
                            <td>@n.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@n.Titulo</td>
                            <td>@n.Mensaje</td>
                            <td>
                                <span class="badge bg-@Model.BadgeFor(n.Tipo)">
                                    @n.Tipo
                                </span>
                            </td>
                            <td>
                                @if (n.Leida)
                                {
                                    <span class="badge bg-secondary">Leída</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Nueva</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group dropstart">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                        Opciones
                                    </button>
                                    <ul class="dropdown-menu">
                                        @if (!n.Leida)
                                        {
                                            <li>
                                                <form method="post" asp-page-handler="MarkRead" class="px-3 py-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@n.Id" />
                                                    <button class="btn btn-link p-0">Marcar como leída</button>
                                                </form>
                                            </li>
                                        }
                                        <li>
                                            <form method="post" asp-page-handler="Delete" class="px-3 py-1"
                                                  onsubmit="return confirm('¿Eliminar esta notificación?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@n.Id" />
                                                <button class="btn btn-link text-danger p-0">Eliminar</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center py-4 text-muted">Sin notificaciones.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
