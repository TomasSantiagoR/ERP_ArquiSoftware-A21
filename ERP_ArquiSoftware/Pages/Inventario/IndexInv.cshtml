@page
@model ERP_ArquiSoftware.Pages.Inventario.IndexInvModel
@{
    ViewData["Title"] = "Módulo Inventario";
}

@section Styles {
    <link rel="stylesheet" href="~/css/inventario/invindex.css" />
}

<a asp-page="CreateInv" class="btn btn-primary mb-2">Ingresar Nuevo Producto</a>

<div class="card shadow mt-2">
    <div class="card-header">
        <h3>@ViewData["Title"]</h3>
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-sm-6 col-md-4">
                <input name="q" value="@Model.Q" class="form-control" placeholder="Buscar por nombre, SKU, marca o categoría..." />
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-secondary" type="submit">Buscar</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>SKU</th>
                        <th>Categoría</th>
                        <th>Marca</th>
                        <th>Unidad</th>
                        <th>Precio</th>
                        <th>Impuesto</th>
                        <th>Stock Actual</th>
                        <th>Stock Mínimo</th>
                        <th>Estado</th>
                        <th>Creación</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Productos != null && Model.Productos.Any())
                    {
                        foreach (var producto in Model.Productos)
                        {
                            <tr>
                                <td>@producto.Id</td>
                                <td>@producto.NombreProducto</td>
                                <td>@producto.Sku</td>
                                <td>@producto.Categoria</td>
                                <td>@producto.Marca</td>
                                <td>@producto.Unidad</td>
                                <td>@producto.Precio.ToString("C")</td>
                                <td>@producto.Impuesto</td>
                                <td>@producto.StockActual</td>
                                <td>@producto.StockMin</td>
                                <td>
                                    @if (producto.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td>@producto.FechaCreacion.ToString("yyyy-MM-dd")</td>
                                <td class="d-flex gap-2">
                                    <a asp-page="/Inventario/EditInv" asp-route-id="@producto.Id" class="btn btn-sm btn-primary">
                                        Editar
                                    </a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@producto.Id"
                                          onsubmit="return confirm('¿Confirmar eliminación del producto?')">
                                        <button type="submit" class="btn btn-sm btn-danger">Borrar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="13" class="text-center py-4">
                                No hay productos disponibles en este momento.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
