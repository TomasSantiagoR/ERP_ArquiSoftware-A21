@page
@model ERP_ArquiSoftware.Pages.Inventario.EditInvModel
@{
    ViewData["Title"] = "Editar Producto";
}


<div class="card shadow">
    <div class="card-header">
        <h3>@ViewData["Title"]</h3>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-6">
                <form method="post">
                    <input type="hidden" asp-for="Productos.Id" />
                    <div class="form-group">
                        <label asp-for="Productos.NombreProducto" class="control-label"></label>
                        <input asp-for="Productos.NombreProducto" class="form-control" />
                        <span asp-validation-for="Productos.NombreProducto" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Productos.Descripcion" class="control-label"></label>
                        <input asp-for="Productos.Descripcion" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="Productos.PrecioUnitario" class="control-label"></label>
                        <input asp-for="Productos.PrecioUnitario" class="form-control" />
                        <span asp-validation-for="Productos.PrecioUnitario" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Productos.Stock" class="control-label"></label>
                        <input asp-for="Productos.Stock" class="form-control" />
                        <span asp-validation-for="Productos.Stock" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Productos.StockMin" class="control-label"></label>
                        <input asp-for="Productos.StockMin" class="form-control" />
                        <span asp-validation-for="Productos.StockMin" class="text-danger"></span>
                    </div>
                    <div class="form-check form-switch mt-3">
                        <input asp-for="Productos.Activo" class="form-check-input" />
                        <label asp-for="Productos.Activo" class="form-check-label"></label>
                    </div>
                    <div class="form-group mt-2">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a asp-page="IndexInv" class="btn btn-success">Volver</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}