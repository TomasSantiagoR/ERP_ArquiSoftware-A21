@page
@model ERP_ArquiSoftware.Pages.Inventario.CreateInvModel
@{
    ViewData["Title"] = "Crear Producto";
}

<div class="card shadow">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="m-0">@ViewData["Title"]</h3>
        <a asp-page="IndexInv" class="btn btn-outline-secondary">Volver</a>
    </div>

    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <!-- Columna izquierda -->
                <div class="col-12 col-lg-6">

                    <div class="mb-3">
                        <label asp-for="Productos.NombreProducto" class="form-label"></label>
                        <input asp-for="Productos.NombreProducto" class="form-control" />
                        <span asp-validation-for="Productos.NombreProducto" class="text-danger"></span>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-6">
                            <label asp-for="Productos.Sku" class="form-label"></label>
                            <input asp-for="Productos.Sku" class="form-control" />
                            <span asp-validation-for="Productos.Sku" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Productos.Gtin" class="form-label"></label>
                            <input asp-for="Productos.Gtin" class="form-control" />
                            <span asp-validation-for="Productos.Gtin" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Productos.CategoriaId" class="form-label"></label>
                        <select asp-for="Productos.CategoriaId" class="form-select" asp-items="Model.CategoriasSelect">
                            <option value="">-- Seleccione Categoría --</option>
                        </select>
                        <span asp-validation-for="Productos.CategoriaId" class="text-danger"></span>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-6">
                            <label asp-for="Productos.MarcaId" class="form-label"></label>
                            <select asp-for="Productos.MarcaId" class="form-select" asp-items="Model.MarcasSelect">
                                <option value="">-- Sin marca --</option>
                            </select>
                            <span asp-validation-for="Productos.MarcaId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Productos.UnidadMedidaId" class="form-label"></label>
                            <select asp-for="Productos.UnidadMedidaId" class="form-select" asp-items="Model.UnidadesSelect">
                                <option value="">-- Unidad --</option>
                            </select>
                            <span asp-validation-for="Productos.UnidadMedidaId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Productos.Descripcion" class="form-label"></label>
                        <textarea asp-for="Productos.Descripcion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Productos.Descripcion" class="text-danger"></span>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-6">
                            <label asp-for="Productos.PrecioUnitario" class="form-label"></label>
                            <input asp-for="Productos.PrecioUnitario" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Productos.PrecioUnitario" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Productos.ImpuestoId" class="form-label"></label>
                            <select asp-for="Productos.ImpuestoId" class="form-select" asp-items="Model.ImpuestosSelect">
                                <option value="">-- Sin impuesto --</option>
                            </select>
                            <span asp-validation-for="Productos.ImpuestoId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row g-2 mt-1">
                        <div class="col-md-4">
                            <label asp-for="Productos.CostoEstandar" class="form-label"></label>
                            <input asp-for="Productos.CostoEstandar" class="form-control" type="number" step="0.01" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Productos.CostoPromedio" class="form-label"></label>
                            <input asp-for="Productos.CostoPromedio" class="form-control" type="number" step="0.01" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Productos.UltimoCosto" class="form-label"></label>
                            <input asp-for="Productos.UltimoCosto" class="form-control" type="number" step="0.01" />
                        </div>
                    </div>

                </div>

                <!-- Columna derecha -->
                <div class="col-12 col-lg-6">

                    <div class="row g-2">
                        <div class="col-md-6">
                            <label asp-for="Productos.StockMin" class="form-label"></label>
                            <input asp-for="Productos.StockMin" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Productos.StockMin" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Productos.PuntoReorden" class="form-label"></label>
                            <input asp-for="Productos.PuntoReorden" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Productos.PuntoReorden" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row g-2 mt-1">
                        <div class="col-md-6">
                            <label asp-for="Productos.CantidadReorden" class="form-label"></label>
                            <input asp-for="Productos.CantidadReorden" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Productos.CantidadReorden" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check mt-4">
                                <input asp-for="Productos.Activo" class="form-check-input" />
                                <label asp-for="Productos.Activo" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>

                    <fieldset class="border rounded p-3 mt-3">
                        <legend class="float-none w-auto px-2 fs-6">Stock Inicial</legend>
                        <div class="row g-2">
                            <div class="col-md-8">
                                <label asp-for="AlmacenId" class="form-label"></label>
                                <select asp-for="AlmacenId" class="form-select" asp-items="Model.AlmacenesSelect">
                                    <option value="">-- Seleccione Almacén --</option>
                                </select>
                                <span asp-validation-for="AlmacenId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="StockInicial" class="form-label"></label>
                                <input asp-for="StockInicial" class="form-control" type="number" min="0" />
                                <span asp-validation-for="StockInicial" class="text-danger"></span>
                            </div>
                        </div>
                    </fieldset>

                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-page="IndexInv" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
