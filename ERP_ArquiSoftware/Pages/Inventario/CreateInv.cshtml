@page
@model ERP_ArquiSoftware.Pages.Inventario.CreateInvModel
@{
    ViewData["Title"] = "Crear Producto";
}

<div class="card shadow">
    <div class="card-header">
        <h3>@ViewData["Title"]</h3>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-12 col-lg-6">
                <form method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Productos.NombreProducto" class="form-label"></label>
                        <input asp-for="Productos.NombreProducto" class="form-control" />
                        <span asp-validation-for="Productos.NombreProducto" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Productos.CategoriaId" class="form-label"></label>
                        <select asp-for="Productos.CategoriaId" class="form-select"
                                asp-items="Model.CategoriasSelect">
                            <option value="">-- Seleccione Categoría --</option>
                        </select>
                        <span asp-validation-for="Productos.CategoriaId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Productos.Descripcion" class="form-label"></label>
                        <input asp-for="Productos.Descripcion" class="form-control" />
                        <span asp-validation-for="Productos.Descripcion" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Productos.PrecioUnitario" class="form-label"></label>
                        <input asp-for="Productos.PrecioUnitario" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Productos.PrecioUnitario" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Productos.Stock" class="form-label"></label>
                        <input asp-for="Productos.Stock" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Productos.Stock" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Productos.StockMin" class="form-label"></label>
                        <input asp-for="Productos.StockMin" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Productos.StockMin" class="text-danger"></span>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input asp-for="Productos.Activo" class="form-check-input" />
                        <label asp-for="Productos.Activo" class="form-check-label"></label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Guardar</button>
                        <a asp-page="IndexInv" class="btn btn-secondary">Volver</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}