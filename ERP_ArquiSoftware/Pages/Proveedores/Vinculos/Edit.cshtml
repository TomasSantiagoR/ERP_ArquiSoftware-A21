@page "{productoId:int}/{proveedorId:int}/{fechaDesde}"
@model ERP_ArquiSoftware.Pages.Proveedores.Vinculos.EditModel
@{
    ViewData["Title"] = "Editar vínculo proveedor–producto";
}

<div class="card shadow">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="m-0">@ViewData["Title"]</h3>
        <a asp-page="/Proveedores/ProductosProv" class="btn btn-outline-secondary">Volver</a>
    </div>

    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Input.ProductoId" />
            <input type="hidden" asp-for="Input.ProveedorId" />
            <input type="hidden" asp-for="Input.FechaDesde" />

            <div class="row g-3">
                <div class="col-12 col-lg-6">
                    <div class="mb-2">
                        <label class="form-label">Proveedor</label>
                        <input class="form-control" value="@Model.ProveedorNombre" disabled />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Producto</label>
                        <input class="form-control" value="@Model.ProductoNombre" disabled />
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label asp-for="Input.SkuProveedor" class="form-label"></label>
                            <input asp-for="Input.SkuProveedor" class="form-control" />
                            <span asp-validation-for="Input.SkuProveedor" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.PrecioCompra" class="form-label"></label>
                            <input asp-for="Input.PrecioCompra" class="form-control" type="number" step="0.01" min="0" />
                            <span asp-validation-for="Input.PrecioCompra" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row g-2 mt-1">
                        <div class="col-md-6">
                            <label asp-for="Input.PlazoEntregaDias" class="form-label"></label>
                            <input asp-for="Input.PlazoEntregaDias" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Input.PlazoEntregaDias" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check">
                                <input asp-for="Input.EsProveedorPrincipal" class="form-check-input" />
                                <label asp-for="Input.EsProveedorPrincipal" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label">Vigencia</label>
                        <div class="input-group">
                            <span class="input-group-text">Desde</span>
                            <input class="form-control" value="@Model.Input.FechaDesde.ToString("yyyy-MM-dd")" disabled />
                            <span class="input-group-text">Hasta</span>
                            <input asp-for="Input.FechaHasta" class="form-control" type="date" />
                        </div>
                        <small class="text-muted">Deja <em>Hasta</em> vacío para mantenerlo vigente.</small>
                        <span asp-validation-for="Input.FechaHasta" class="text-danger d-block"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button class="btn btn-primary" type="submit">Guardar cambios</button>
                <a asp-page="/Proveedores/ProductosProv" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
