@page
@model ERP_ArquiSoftware.Pages.Proveedores.IndexProvModel
@{
    ViewData["Title"] = "Listado de Proveedores";
}

<div class="card shadow">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="m-0">@ViewData["Title"]</h3>
        <a asp-page="/Proveedores/CreateProv" class="btn btn-primary">Crear proveedor</a>
    </div>

    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-sm-6 col-md-4">
                <input name="q" value="@Model.Q" class="form-control" placeholder="Buscar por nombre o NIT..." />
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-secondary" type="submit">Buscar</button>
            </div>
        </form>

        @if (Model.Proveedores?.Any() == true)
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Nombre/Razón Social</th>
                            <th>NIT</th>
                            <th>Tipo</th>
                            <th>Correo</th>
                            <th>Categoría</th>
                            <th>Activo</th>
                            <th>Creado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Proveedores)
                        {
                            <tr>
                                <td>@p.NombreRazonSocial</td>
                                <td>@p.NIT</td>
                                <td>@p.TipoProveedor</td>
                                <td>@p.CorreoElectronico</td>
                                <td>@p.Categoria?.Nombre</td>
                                <td>
                                    @if (p.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td>@p.FechaCreacion.ToString("yyyy-MM-dd")</td>
                                <td class="d-flex gap-2">
                                    <a asp-page="/Proveedores/EditProv" asp-route-id="@p.Id"
                                       class="btn btn-sm btn-primary">
                                        Editar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted m-0">No hay proveedores que coincidan.</p>
        }
    </div>
</div>


