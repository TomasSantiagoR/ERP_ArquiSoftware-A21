@page "{id:int}"
@model ERP_ArquiSoftware.Pages.Proveedores.EditProvModel
@{
    ViewData["Title"] = "Editar Proveedor";
}

<div class="card shadow">
    <div class="card-header">
        <h3>@ViewData["Title"]</h3>
    </div>
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Proveedor.Id" />

            <!-- DATOS GENERALES -->
            <div class="form-group mb-3">
                <label asp-for="Proveedor.NombreRazonSocial" class="form-label"></label>
                <input asp-for="Proveedor.NombreRazonSocial" class="form-control" />
                <span asp-validation-for="Proveedor.NombreRazonSocial" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Proveedor.NIT" class="form-label"></label>
                <input asp-for="Proveedor.NIT" class="form-control" />
                <span asp-validation-for="Proveedor.NIT" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Proveedor.TipoProveedor" class="form-label"></label>
                <input asp-for="Proveedor.TipoProveedor" class="form-control" />
                <span asp-validation-for="Proveedor.TipoProveedor" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Proveedor.CorreoElectronico" class="form-label"></label>
                <input asp-for="Proveedor.CorreoElectronico" type="email" class="form-control" />
                <span asp-validation-for="Proveedor.CorreoElectronico" class="text-danger"></span>
            </div>

            <!-- DATOS COMERCIALES -->
            <div class="form-group mb-3">
                <label asp-for="Proveedor.CondicionesPago" class="form-label"></label>
                <input asp-for="Proveedor.CondicionesPago" class="form-control" />
                <span asp-validation-for="Proveedor.CondicionesPago" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Proveedor.CuentaBancaria" class="form-label"></label>
                <input asp-for="Proveedor.CuentaBancaria" class="form-control" />
                <span asp-validation-for="Proveedor.CuentaBancaria" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Proveedor.RepresentanteLegal" class="form-label"></label>
                <input asp-for="Proveedor.RepresentanteLegal" class="form-control" />
                <span asp-validation-for="Proveedor.RepresentanteLegal" class="text-danger"></span>
            </div>

            <!-- DOCUMENTOS Y ESTADO -->
            <div class="form-group mb-3">
                <label asp-for="Proveedor.Documentos" class="form-label"></label>
                <input asp-for="Proveedor.Documentos" class="form-control" />
                <span asp-validation-for="Proveedor.Documentos" class="text-danger"></span>
            </div>

            <div class="form-check form-switch mb-3">
                <input asp-for="Proveedor.Activo" class="form-check-input" />
                <label asp-for="Proveedor.Activo" class="form-check-label"></label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                <a asp-page="/Proveedores/IndexProv" class="btn btn-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

