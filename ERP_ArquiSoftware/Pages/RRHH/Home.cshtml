@page
@model ERP_ArquiSoftware.Pages.RRHH.HomeModel
@{
    ViewData["Title"] = "RRHH · Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">@ViewData["Title"]</h3>
    <div class="d-flex gap-2">
        <a asp-page="/RRHH/Empleados/Index" class="btn btn-outline-primary">
            <i class="ri-team-line me-1"></i> Empleados
        </a>
        <a asp-page="/Maestros/Cargos/Index" class="btn btn-outline-secondary">
            <i class="ri-briefcase-4-line me-1"></i> Cargos
        </a>
        <a asp-page="/Maestros/Departamentos/Index" class="btn btn-outline-secondary">
            <i class="ri-building-2-line me-1"></i> Departamentos
        </a>
        <a asp-page="/RRHH/Contratos/Create" class="btn btn-outline-success">
            <i class="ri-file-add-line me-1"></i> Crear Contrato
        </a>
        <a class="btn btn-outline-dark" asp-page="/RRHH/Parametros/Index">
            <i class="ri-settings-3-line me-1"></i> Parámetros Nómina
        </a>
    </div>
</div>

<!-- KPIs -->
<div class="row g-3">
    <div class="col-6 col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="me-3">
                    <i class="ri-user-3-line" style="font-size: 1.6rem;"></i>
                </div>
                <div>
                    <div class="text-muted small">Total empleados</div>
                    <div class="fs-4 fw-bold">@Model.TotalEmpleados</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="me-3">
                    <i class="ri-shield-check-line" style="font-size: 1.6rem;"></i>
                </div>
                <div>
                    <div class="text-muted small">Activos</div>
                    <div class="fs-4 fw-bold text-success">@Model.EmpleadosActivos</div>
                </div>
                <div class="ms-auto text-muted">Inactivos: @Model.EmpleadosInactivos</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="me-3">
                    <i class="ri-contract-line" style="font-size: 1.6rem;"></i>
                </div>
                <div>
                    <div class="text-muted small">Contratos activos</div>
                    <div class="fs-4 fw-bold">@Model.ContratosActivos</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-body d-flex align-items-center">
                <div class="me-3">
                    <i class="ri-timer-line" style="font-size: 1.6rem;"></i>
                </div>
                <div>
                    <div class="text-muted small">Vencen en 30 días</div>
                    <div class="fs-4 fw-bold text-warning">@Model.ContratosPorVencer</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Gráficos -->
<div class="row g-3 mt-1">
    <div class="col-12 col-lg-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <strong><i class="ri-bar-chart-box-line me-1"></i> Empleados activos por departamento</strong>
            </div>
            <div class="card-body">
                <canvas id="deptChart" height="150"></canvas>
                @if (!Model.DeptLabels.Any())
                {
                    <div class="text-muted small mt-2">Sin datos para mostrar.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <strong><i class="ri-pie-chart-2-line me-1"></i> Contratos activos por tipo</strong>
            </div>
            <div class="card-body">
                <canvas id="tipoChart" height="150"></canvas>
                @if (!Model.TipoLabels.Any())
                {
                    <div class="text-muted small mt-2">Sin datos para mostrar.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Últimas nóminas -->
<div class="card shadow-sm mt-3">
    <div class="card-header bg-white d-flex align-items-center justify-content-between">
        <strong><i class="ri-money-dollar-circle-line me-1"></i> Últimas nóminas generadas</strong>
        <a asp-page="/RRHH/Nominas/Index" class="btn btn-sm btn-outline-secondary">Ver todas</a>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle m-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Empleado</th>
                    <th>Periodo</th>
                    <th class="text-end">Neto</th>
                    <th style="width:120px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.UltimasNominas.Any())
                {
                    foreach (var n in Model.UltimasNominas)
                    {
                        <tr>
                            <td>@n.Id</td>
                            <td>@n.Empleado</td>
                            <td>@n.Periodo</td>
                            <td class="text-end">@n.Neto.ToString("C")</td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a class="btn btn-sm btn-outline-primary" asp-page="/RRHH/Nominas/Details" asp-route-id="@n.Id">
                                        Detalles
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center py-3 text-muted">Aún no hay nóminas registradas.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Datos inyectados desde el servidor
        const deptLabels = @Html.Raw(Model.DeptLabelsJson);
        const deptData   = @Html.Raw(Model.DeptDataJson);
        const tipoLabels = @Html.Raw(Model.TipoLabelsJson);
        const tipoData   = @Html.Raw(Model.TipoDataJson);

        // Bar: empleados por departamento
        const deptCtx = document.getElementById('deptChart');
        if (deptCtx && deptLabels.length) {
            new Chart(deptCtx, {
                type: 'bar',
                data: {
                    labels: deptLabels,
                    datasets: [{
                        label: 'Activos',
                        data: deptData
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        }

        // Doughnut: contratos por tipo
        const tipoCtx = document.getElementById('tipoChart');
        if (tipoCtx && tipoLabels.length) {
            new Chart(tipoCtx, {
                type: 'doughnut',
                data: {
                    labels: tipoLabels,
                    datasets: [{
                        data: tipoData
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    },
                    cutout: '55%'
                }
            });
        }
    </script>
}

