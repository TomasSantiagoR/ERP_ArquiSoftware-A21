@page
@model ERP_ArquiSoftware.Pages.RRHH.Parametros.IndexModel
@{
    ViewData["Title"] = "Parámetros de Nómina";
}
<div class="card shadow">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="m-0">@ViewData["Title"]</h3>
    </div>
    <div class="card-body">
        @if (TempData["ok"] is string ok)
        {
            <div class="alert alert-success">@ok</div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Input.Id" />

            <div class="row g-2">
                <div class="col-md-2">
                    <label asp-for="Input.Anio" class="form-label"></label>
                    <input asp-for="Input.Anio" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.SMMLV" class="form-label"></label>
                    <input asp-for="Input.SMMLV" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.AuxilioTransporte" class="form-label"></label>
                    <input asp-for="Input.AuxilioTransporte" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.TopeAuxTranspMultiplo" class="form-label"></label>
                    <input asp-for="Input.TopeAuxTranspMultiplo" class="form-control" />
                    <div class="form-text">Aplica aux. si Salario ≤ SMMLV × este múltiplo</div>
                </div>
            </div>

            <hr />
            <div class="row g-2">
                <div class="col-md-3">
                    <label asp-for="Input.SaludEmpleadoPorc" class="form-label"></label>
                    <input asp-for="Input.SaludEmpleadoPorc" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.PensionEmpleadoPorc" class="form-label"></label>
                    <input asp-for="Input.PensionEmpleadoPorc" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.CesantiasPorc" class="form-label"></label>
                    <input asp-for="Input.CesantiasPorc" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.InteresesCesantiasAnualPorc" class="form-label"></label>
                    <input asp-for="Input.InteresesCesantiasAnualPorc" class="form-control" />
                </div>
            </div>

            <div class="row g-2 mt-1">
                <div class="col-md-3">
                    <label asp-for="Input.PrimaPorc" class="form-label"></label>
                    <input asp-for="Input.PrimaPorc" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.VacacionesPorc" class="form-label"></label>
                    <input asp-for="Input.VacacionesPorc" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.DiasMes" class="form-label"></label>
                    <input asp-for="Input.DiasMes" class="form-control" />
                </div>
                <div class="col-md-3 d-flex align-items-center">
                    <div class="form-check mt-4">
                        <input asp-for="Input.Activo" class="form-check-input" />
                        <label asp-for="Input.Activo" class="form-check-label">Activo</label>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>
