@page
@model ERP_ArquiSoftware.Pages.RRHH.Contratos.CreateModel
@{
    ViewData["Title"] = "Nuevo Contrato";
}
<div class="card shadow">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="m-0">@ViewData["Title"]</h3>
        <a asp-page="/RRHH/Empleados/Index" class="btn btn-outline-secondary">Volver</a>
    </div>
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="row g-2">
                <div class="col-md-4">
                    <label asp-for="Input.EmpleadoId" class="form-label">Empleado</label>
                    <select asp-for="Input.EmpleadoId" class="form-select" asp-items="Model.EmpleadosSelect">
                        <option value="">-- Seleccione --</option>
                    </select>
                    <span asp-validation-for="Input.EmpleadoId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.TipoContratoId" class="form-label">Tipo de Contrato</label>
                    <select asp-for="Input.TipoContratoId" class="form-select" asp-items="Model.TiposSelect">
                        <option value="">-- Seleccione --</option>
                    </select>
                    <span asp-validation-for="Input.TipoContratoId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Salario" class="form-label">Salario</label>
                    <input asp-for="Input.Salario" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Input.Salario" class="text-danger"></span>
                </div>
            </div>

            <div class="row g-2 mt-1">
                <div class="col-md-4">
                    <label asp-for="Input.FechaInicio" class="form-label">Fecha Inicio</label>
                    <input asp-for="Input.FechaInicio" class="form-control" type="date" />
                    <span asp-validation-for="Input.FechaInicio" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.FechaFin" class="form-label">Fecha Fin (opcional)</label>
                    <input asp-for="Input.FechaFin" class="form-control" type="date" />
                </div>
                <div class="col-md-4 form-check mt-4">
                    <input asp-for="Input.Activo" class="form-check-input" />
                    <label asp-for="Input.Activo" class="form-check-label"></label>
                </div>
            </div>

            <div class="mt-3">
                <button class="btn btn-primary" type="submit">Guardar</button>
                <a asp-page="/RRHH/Empleados/Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
