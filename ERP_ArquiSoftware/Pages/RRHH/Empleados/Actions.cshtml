@page "{id:int}"
@model ERP_ArquiSoftware.Pages.RRHH.Empleados.ActionsModel
@{
    ViewData["Title"] = "Acciones de Empleado";
}
<div class="card shadow">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="m-0">@ViewData["Title"]</h3>
        <a asp-page="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
    <div class="card-body">
        @if (TempData["ok"] is string ok)
        {
            <div class="alert alert-success">@ok</div>
        }
        <div asp-validation-summary="All" class="text-danger mb-2"></div>

        @if (Model.Empleado is null)
        {
            <div class="alert alert-danger">Empleado no encontrado.</div>
        }
        else
        {
            <div class="mb-3">
                <strong>Empleado:</strong> @Model.Empleado.Nombres @Model.Empleado.Apellidos
                <span class="text-muted">(@Model.Empleado.Documento)</span>
                <div class="small text-muted">
                    Contrato activo:
                    @{
                        var c = Model.Empleado.Contratos.FirstOrDefault();
                    }
                    @(c is null ? "—" : $"{c.TipoContrato?.Nombre ?? "—"} | Salario: {c.Salario:C0} | Desde: {c.FechaInicio:yyyy-MM-dd} {(c.FechaFin.HasValue ? $"Hasta: {c.FechaFin:yyyy-MM-dd}" : "")}")
                </div>
            </div>

            <div class="row g-3">
                <div class="col-lg-6">
                    <div class="card h-100">
                        <div class="card-header"><strong>Calcular Nómina Mensual</strong></div>
                        <div class="card-body">
                            <form method="post" asp-page-handler="CalcularNomina">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Empleado.Id" />

                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <label asp-for="Anio" class="form-label"></label>
                                        <input asp-for="Anio" class="form-control" />
                                    </div>
                                    <div class="col-md-4">
                                        <label asp-for="Mes" class="form-label"></label>
                                        <input asp-for="Mes" class="form-control" min="1" max="12" />
                                    </div>
                                </div>

                                <div class="row g-2 mt-1">
                                    <div class="col-md-6">
                                        <label asp-for="OtrosDevengos" class="form-label">Otros Devengos</label>
                                        <input asp-for="OtrosDevengos" class="form-control" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="OtrasDeducciones" class="form-label">Otras Deducciones</label>
                                        <input asp-for="OtrasDeducciones" class="form-control" />
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <button class="btn btn-primary">Generar Nómina</button>
                                </div>
                            </form>

                            @if (Model.NominaGenerada is not null)
                            {
                                <hr />
                                <div class="small">
                                    <div><strong>Neto a Pagar:</strong> @Model.NominaGenerada.NetoPagar.ToString("C0")</div>
                                    <div>Devengado: @Model.NominaGenerada.TotalDevengado.ToString("C0")</div>
                                    <div>Deducciones: @Model.NominaGenerada.TotalDeducciones.ToString("C0")</div>
                                    <div>Auxilio Transporte: @Model.NominaGenerada.AuxilioTransporte.ToString("C0")</div>
                                    <div>Provisiones — Ces: @Model.NominaGenerada.ProvCesantias.ToString("C0"), IntCes: @Model.NominaGenerada.ProvInteresesCesantias.ToString("C0"), Prima: @Model.NominaGenerada.ProvPrima.ToString("C0"), Vac: @Model.NominaGenerada.ProvVacaciones.ToString("C0")</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card h-100">
                        <div class="card-header"><strong>Generar Liquidación</strong></div>
                        <div class="card-body">
                            <form method="post" asp-page-handler="Liquidar">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Empleado.Id" />

                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label asp-for="FechaFin" class="form-label"></label>
                                        <input asp-for="FechaFin" class="form-control" type="date" />
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="OtrasDeducciones" class="form-label">Otras Deducciones</label>
                                        <input asp-for="OtrasDeducciones" class="form-control" />
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <button class="btn btn-danger">Generar Liquidación</button>
                                </div>
                            </form>

                            @if (Model.LiquidacionGenerada is not null)
                            {
                                <hr />
                                <div class="small">
                                    <div><strong>Neto Liquidación:</strong> @Model.LiquidacionGenerada.NetoPagar.ToString("C0")</div>
                                    <div>Cesantías: @Model.LiquidacionGenerada.Cesantias.ToString("C0")</div>
                                    <div>Intereses Cesantías: @Model.LiquidacionGenerada.InteresesCesantias.ToString("C0")</div>
                                    <div>Prima: @Model.LiquidacionGenerada.Prima.ToString("C0")</div>
                                    <div>Vacaciones: @Model.LiquidacionGenerada.Vacaciones.ToString("C0")</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
