@page
@model ERP_ArquiSoftware.Pages.RRHH.Empleados.IndexModel
@{
    ViewData["Title"] = "Empleados";
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h3 class="m-0">@ViewData["Title"]</h3>
    <a asp-page="Create" class="btn btn-primary">Nuevo Empleado</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input name="q" value="@Model.Q" class="form-control" placeholder="Buscar por nombre, documento, correo o almacén..." />
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Buscar</button></div>
</form>

<div class="card">
    <!-- Importante: permitir overflow vertical para que el dropdown no se recorte -->
    <div class="table-responsive" style="overflow-y:visible; overflow-x:auto;">
        <table class="table table-striped table-hover align-middle m-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Documento</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Teléfono</th>
                    <th>Almacén</th>
                    <th>Departamento</th>
                    <th>Cargo</th>
                    <th>Activo</th>
                    <th>Ingreso</th>
                    <th style="width: 120px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var e in Model.Items)
                    {
                        <tr>
                            <td>@e.Id</td>
                            <td>@e.Documento</td>
                            <td>@($"{e.Nombres} {e.Apellidos}")</td>
                            <td>@e.Correo</td>
                            <td>@e.Telefono</td>
                            <td>@(e.Almacen?.Nombre ?? "—")</td>
                            <td>@(e.Departamento?.Nombre ?? "—")</td>
                            <td>@(e.Cargo?.Nombre ?? "—")</td>
                            <td>
                                @if (e.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td>@e.FechaIngreso.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                            data-bs-toggle="dropdown"
                                            data-bs-display="static"
                                            data-bs-boundary="viewport"
                                            data-bs-offset="0,8"
                                            aria-expanded="false">
                                        Opciones
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="Edit" asp-route-id="@e.Id">
                                                Editar
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-page="Actions" asp-route-id="@e.Id">
                                                Acciones
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="11" class="text-center py-4 text-muted">No hay resultados.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

