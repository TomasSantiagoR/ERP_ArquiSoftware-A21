@page
@model ERP_ArquiSoftware.Pages.Ventas.CondicionesPago.IndexModel
@{
    ViewData["Title"] = "Condiciones de Pago";
}
<div class="d-flex justify-content-between align-items-center mb-2">
    <h3 class="m-0">@ViewData["Title"]</h3>
    <a asp-page="Upsert" class="btn btn-primary">Nueva Condición</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input name="q" value="@Model.Q" class="form-control" placeholder="Buscar por nombre..." />
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Buscar</button></div>
</form>

<div class="card">
    <div class="table-responsive table-scroll">
        <table class="table table-striped table-hover align-middle m-0 table-sticky">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Días Plazo</th>
                    <th>Clientes usando</th>
                    <th style="width:140px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var r in Model.Items)
                    {
                        <tr>
                            <td>@r.Id</td>
                            <td>@r.Nombre</td>
                            <td>@r.DiasPlazo</td>
                            <td>@r.ClientesCount</td>
                            <td class="text-end">
                                <a asp-page="Upsert" asp-route-id="@r.Id" class="btn btn-sm btn-primary">Editar</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@r.Id" class="d-inline"
                                      onsubmit="return confirm('¿Eliminar condición?')">
                                    <button class="btn btn-sm btn-danger">Borrar</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center py-4 text-muted">Sin registros.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

