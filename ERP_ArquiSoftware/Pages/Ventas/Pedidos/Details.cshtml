@page "{id:int}"
@model ERP_ArquiSoftware.Pages.Ventas.Pedidos.DetailsModel
@{
    ViewData["Title"] = "Detalle de Pedido";
}
<a asp-page="Index" class="btn btn-outline-secondary mb-2">Volver</a>

@if (Model.Pedido is null)
{
    <div class="alert alert-danger">Pedido no encontrado.</div>
}
else
{
    <div class="card shadow">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h3 class="m-0">Pedido @Model.Pedido.Serie-@Model.Pedido.Numero</h3>
                <small class="text-muted">Fecha: @Model.Pedido.Fecha:yyyy-MM-dd HH:mm</small>
            </div>
            <div class="d-flex gap-2">
                @if (Model.Pedido.Estado == "Confirmado")
                {
                    <form method="post" asp-page-handler="Facturar" asp-route-id="@Model.Pedido.Id"
                          onsubmit="return confirm('¿Generar factura y descontar stock?')">
                        <button class="btn btn-success">Generar factura</button>
                    </form>
                }
                else if (Model.Pedido.Estado == "Facturado")
                {
                    <span class="badge bg-success align-self-center">FACTURADO</span>
                }
                else if (Model.Pedido.Estado == "Cancelado")
                {
                    <span class="badge bg-danger align-self-center">CANCELADO</span>
                }
            </div>
        </div>

        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="border rounded p-2">
                        <div class="fw-bold">Cliente</div>
                        <div>@Model.Pedido.Cliente?.NombreRazonSocial</div>
                        <div class="text-muted small">@Model.Pedido.Cliente?.TipoDocumento @Model.Pedido.Cliente?.NumeroDocumento</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-2">
                        <div class="fw-bold">Almacén</div>
                        <div>@Model.Pedido.Almacen?.Nombre</div>
                        <div class="text-muted small">@Model.Pedido.Almacen?.Direccion</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-2">
                        <div class="fw-bold">Condición de pago</div>
                        <div>@(Model.Pedido.CondicionPago?.Nombre ?? "Contado")</div>
                        <div class="text-muted small">Estado: @Model.Pedido.Estado</div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle m-0">
                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th>Producto</th>
                            <th class="text-end">Cant.</th>
                            <th class="text-end">Precio</th>
                            <th class="text-end">Neto</th>
                            <th class="text-end">Imp.</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Pedido.Lineas)
                        {
                            <tr>
                                <td>@l.Producto?.Sku</td>
                                <td>@l.Producto?.NombreProducto</td>
                                <td class="text-end">@l.Cantidad</td>
                                <td class="text-end">@l.PrecioUnitario.ToString("C")</td>
                                <td class="text-end">@l.ImporteNeto.ToString("C")</td>
                                <td class="text-end">@l.ImporteImpuesto.ToString("C")</td>
                                <td class="text-end">@l.ImporteTotal.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="4"></th>
                            <th class="text-end">@Model.Pedido.Subtotal.ToString("C")</th>
                            <th class="text-end">@Model.Pedido.TotalImpuestos.ToString("C")</th>
                            <th class="text-end">@Model.Pedido.Total.ToString("C")</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}
