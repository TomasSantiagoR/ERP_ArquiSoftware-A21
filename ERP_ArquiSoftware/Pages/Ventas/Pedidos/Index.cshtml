@page
@model ERP_ArquiSoftware.Pages.Ventas.Pedidos.IndexModel
@{
    ViewData["Title"] = "Pedidos de Venta";
}
<div class="d-flex justify-content-between align-items-center mb-2">
    <h3 class="m-0">@ViewData["Title"]</h3>
    <a asp-page="Create" class="btn btn-primary">Nuevo Pedido</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input name="q" value="@Model.Q" class="form-control" placeholder="Buscar por cliente, serie-número o estado..." />
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Buscar</button></div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle m-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th>Almacén</th>
                    <th>Estado</th>
                    <th class="text-end">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items?.Any() == true)
                {
                    foreach (var p in Model.Items)
                    {
                        <tr>
                            <td>@p.Serie-@p.Numero</td>
                            <td>@p.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@p.Cliente?.NombreRazonSocial</td>
                            <td>@p.Almacen?.Nombre</td>
                            <td>
                                @switch (p.Estado)
                                {
                                    case "Borrador":
                                        <span class="badge bg-secondary">Borrador</span>
                                        ; break;
                                    case "Confirmado":

                                        <span class="badge bg-primary">Confirmado</span>
                                        ; break;
                                    case "Facturado":

                                        <span class="badge bg-success">Facturado</span>
                                        ; break;
                                    case "Cancelado":

                                        <span class="badge bg-danger">Cancelado</span>
                                        ; break;
                                    default:

                                        @p.Estado
                                        ; break;
                                }
                            </td>
                            <td class="text-end">@p.Total.ToString("C")</td>
                            <td class="text-end">
                                <a asp-page="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center py-4 text-muted">Sin resultados</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

