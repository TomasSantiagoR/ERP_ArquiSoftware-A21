@page
@model ERP_ArquiSoftware.Pages.Ventas.Clientes.IndexModel
@{
    ViewData["Title"] = "Clientes";
}
<div class="d-flex justify-content-between align-items-center mb-2">
    <h3 class="m-0">@ViewData["Title"]</h3>
    <a asp-page="Upsert" class="btn btn-primary">Nuevo Cliente</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-5">
        <input name="q" value="@Model.Q" class="form-control" placeholder="Buscar por documento, nombre, correo, teléfono..." />
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Buscar</button></div>
</form>

<div class="card">
    <div class="table-responsive table-scroll">
        <table class="table table-striped table-hover align-middle m-0 table-sticky">
            <thead>
                <tr>
                    <th>Documento</th>
                    <th>Nombre / Comercial</th>
                    <th>Contacto</th>
                    <th>Cond. Pago</th>
                    <th>Estado</th>
                    <th style="width:140px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var c in Model.Items)
                    {
                        <tr>
                            <td>@($"{c.TipoDocumento} {c.NumeroDocumento}")</td>
                            <td>
                                <div>@c.NombreRazonSocial</div>
                                @if (!string.IsNullOrWhiteSpace(c.NombreComercial))
                                {
                                    <div class="text-muted small">@c.NombreComercial</div>
                                }
                            </td>
                            <td>
                                <div>@(c.Correo ?? "—")</div>
                                <div class="text-muted small">@((c.Telefono ?? "—"))</div>
                            </td>
                            <td>@(c.CondicionPagoNombre ?? "—")</td>
                            <td>
                                @if (c.Activo)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {

                                    <span class="badge bg-secondary">Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-page="Upsert" asp-route-id="@c.Id" class="btn btn-sm btn-primary">Editar</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@c.Id" class="d-inline"
                                      onsubmit="return confirm('¿Eliminar cliente?')">
                                    <button class="btn btn-sm btn-danger">Borrar</button>
                                    <a asp-page="/Ventas/Clientes/Direcciones" asp-route-clienteId="@c.Id"
                                       class="btn btn-sm btn-outline-info">Direcciones</a>

                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center py-4 text-muted">Sin registros.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

