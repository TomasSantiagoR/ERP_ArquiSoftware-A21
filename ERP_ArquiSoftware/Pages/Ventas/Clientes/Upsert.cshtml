@page "{id:int?}"
@model ERP_ArquiSoftware.Pages.Ventas.Clientes.UpsertModel
@{
    ViewData["Title"] = Model.Input.Id == 0 ? "Nuevo Cliente" : "Editar Cliente";
}
<div class="card shadow">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="m-0">@ViewData["Title"]</h3>
        <a asp-page="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="Input.Id" />

            <div class="row g-2">
                <div class="col-md-3">
                    <label asp-for="Input.TipoDocumento" class="form-label"></label>
                    <select asp-for="Input.TipoDocumento" class="form-select">
                        <option>CC</option>
                        <option>NIT</option>
                        <option>CE</option>
                        <option>PP</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label asp-for="Input.NumeroDocumento" class="form-label"></label>
                    <input asp-for="Input.NumeroDocumento" class="form-control" />
                    <span asp-validation-for="Input.NumeroDocumento" class="text-danger"></span>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="Input.Activo" class="form-check-input" />
                        <label asp-for="Input.Activo" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="mb-2 mt-2">
                <label asp-for="Input.NombreRazonSocial" class="form-label"></label>
                <input asp-for="Input.NombreRazonSocial" class="form-control" />
                <span asp-validation-for="Input.NombreRazonSocial" class="text-danger"></span>
            </div>

            <div class="row g-2">
                <div class="col-md-6">
                    <label asp-for="Input.NombreComercial" class="form-label"></label>
                    <input asp-for="Input.NombreComercial" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.CondicionPagoId" class="form-label"></label>
                    <select asp-for="Input.CondicionPagoId" class="form-select"
                            asp-items="Model.CondicionesSelect">
                        <option value="">-- Contado --</option>
                    </select>
                </div>
            </div>

            <div class="row g-2 mt-1">
                <div class="col-md-6">
                    <label asp-for="Input.Correo" class="form-label"></label>
                    <input asp-for="Input.Correo" class="form-control" />
                    <span asp-validation-for="Input.Correo" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Telefono" class="form-label"></label>
                    <input asp-for="Input.Telefono" class="form-control" />
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary" type="submit">Guardar</button>
                <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}

