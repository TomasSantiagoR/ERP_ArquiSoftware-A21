@page
@model ERP_ArquiSoftware.Pages.Maestros.Departamentos.IndexModel
@{
    ViewData["Title"] = "Departamentos";
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h3 class="m-0">@ViewData["Title"]</h3>
    <a asp-page="Upsert" class="btn btn-primary">Nuevo Departamento</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input name="q" value="@Model.Q" class="form-control" placeholder="Buscar por nombre..." />
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary">Buscar</button></div>
</form>

<div class="card">
    <div class="table-responsive table-scroll">
        <table class="table table-striped table-hover align-middle m-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Empleados</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Items.Any())
            {
                foreach (var d in Model.Items)
                {
                    <tr>
                        <td>@d.Id</td>
                        <td>@d.Nombre</td>
                        <td>@d.EmpleadosCount</td>
                        <td class="text-end">
                            <a asp-page="Upsert" asp-route-id="@d.Id" class="btn btn-sm btn-primary">Editar</a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@d.Id" class="d-inline"
                                  onsubmit="return confirm('¿Eliminar departamento?')">
                                <button class="btn btn-sm btn-danger">Borrar</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4" class="text-center py-4 text-muted">Sin registros.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
