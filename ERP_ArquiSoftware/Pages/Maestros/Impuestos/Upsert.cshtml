@page "{id:int?}"
@model ERP_ArquiSoftware.Pages.Maestros.Impuestos.UpsertModel
@{
    ViewData["Title"] = Model.Input.Id == 0 ? "Nuevo Impuesto" : "Editar Impuesto";
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="m-0">@ViewData["Title"]</h3>
        <a asp-page="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Input.Id" />

            <div class="mb-3">
                <label asp-for="Input.Nombre" class="form-label"></label>
                <input asp-for="Input.Nombre" class="form-control" />
                <span asp-validation-for="Input.Nombre" class="text-danger"></span>
            </div>

            <div class="row g-2">
                <div class="col-md-6">
                    <label asp-for="Input.Porcentaje" class="form-label"></label>
                    <input asp-for="Input.Porcentaje" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Input.Porcentaje" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-check mt-4">
                    <input asp-for="Input.IncluidoEnPrecio" class="form-check-input" />
                    <label asp-for="Input.IncluidoEnPrecio" class="form-check-label"></label>
                </div>
            </div>

            <div class="form-check my-3">
                <input asp-for="Input.Activo" class="form-check-input"/>
                <label asp-for="Input.Activo" class="form-check-label"></label>
            </div>

            <button class="btn btn-primary">Guardar</button>
            <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
