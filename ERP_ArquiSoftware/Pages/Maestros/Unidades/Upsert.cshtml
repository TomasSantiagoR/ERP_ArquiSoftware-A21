@page "{id:int?}"
@model ERP_ArquiSoftware.Pages.Maestros.Unidades.UpsertModel
@{
    ViewData["Title"] = Model.Input.Id == 0 ? "Nueva Unidad" : "Editar Unidad";
}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="m-0">@ViewData["Title"]</h3>
        <a asp-page="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Input.Id" />
            <div class="mb-3">
                <label asp-for="Input.Codigo" class="form-label"></label>
                <input asp-for="Input.Codigo" class="form-control" />
                <span asp-validation-for="Input.Codigo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Descripcion" class="form-label"></label>
                <input asp-for="Input.Descripcion" class="form-control" />
                <span asp-validation-for="Input.Descripcion" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Input.Activa" class="form-check-input"/>
                <label asp-for="Input.Activa" class="form-check-label"></label>
            </div>
            <button class="btn btn-primary">Guardar</button>
            <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
