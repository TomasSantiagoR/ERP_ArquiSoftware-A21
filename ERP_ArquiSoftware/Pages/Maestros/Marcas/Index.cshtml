@page
@model ERP_ArquiSoftware.Pages.Maestros.Marcas.IndexModel
@{
    ViewData["Title"] = "Marcas";
}
<div class="d-flex justify-content-between align-items-center mb-2">
    <h3 class="m-0">@ViewData["Title"]</h3>
    <a asp-page="Upsert" class="btn btn-primary">Nueva Marca</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input name="q" value="@Model.Q" class="form-control" placeholder="Buscar por nombre..." />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" type="submit">Buscar</button>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle m-0">
            <thead>
            <tr>
                <th>ID</th><th>Nombre</th><th>Estado</th><th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var m in Model.Items)
            {
                <tr>
                    <td>@m.Id</td>
                    <td>@m.Nombre</td>
                    <td>
                        @if (m.Activa) { <span class="badge bg-success">Activa</span> }
                        else { <span class="badge bg-secondary">Inactiva</span> }
                    </td>
                    <td class="text-end">
                        <a asp-page="Upsert" asp-route-id="@m.Id" class="btn btn-sm btn-primary">Editar</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@m.Id"
                              class="d-inline" onsubmit="return confirm('¿Eliminar marca?')">
                            <button class="btn btn-sm btn-danger">Borrar</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
