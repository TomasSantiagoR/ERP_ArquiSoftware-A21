@page "{id:int?}"
@model ERP_ArquiSoftware.Pages.Maestros.Cargos.UpsertModel
@{
    ViewData["Title"] = Model.Input.Id == 0 ? "Nuevo Cargo" : "Editar Cargo";
}

<div class="card shadow">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="m-0">@ViewData["Title"]</h3>
        <a asp-page="Index" class="btn btn-outline-secondary">Volver</a>
    </div>

    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <input type="hidden" asp-for="Input.Id" />

            <div class="mb-2">
                <label asp-for="Input.Nombre" class="form-label"></label>
                <input asp-for="Input.Nombre" class="form-control" />
                <span asp-validation-for="Input.Nombre" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="Input.Descripcion" class="form-label"></label>
                <textarea asp-for="Input.Descripcion" rows="3" class="form-control"></textarea>
                <span asp-validation-for="Input.Descripcion" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="Input.SalarioBase" class="form-label"></label>
                <input asp-for="Input.SalarioBase" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Input.SalarioBase" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary" type="submit">Guardar</button>
                <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
