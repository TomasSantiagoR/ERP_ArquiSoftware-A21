@page "{id:int}"
@model ERP_ArquiSoftware.Pages.Facturacion.Facturas.DetailsModel
@{
    ViewData["Title"] = "Detalle de Factura";
}

<a asp-page="Index" class="btn btn-outline-secondary mb-2">Volver</a>

@if (Model.Factura is null)
{
    <div class="alert alert-danger">Factura no encontrada.</div>
}
else
{
    <div class="card shadow">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <h3 class="m-0">Factura @Model.Factura.Serie-@Model.Factura.Numero</h3>
                <small class="text-muted">Fecha: @Model.Factura.Fecha.ToString("yyyy-MM-dd HH:mm")</small>
            </div>
            <div class="d-flex gap-2">
                @if (Model.Factura.Estado != "Anulada")
                {
                    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalCobro">Registrar cobro</button>
                    <form method="post" asp-page-handler="Anular" asp-route-id="@Model.Factura.Id"
                          onsubmit="return confirm('¿Anular la factura? Esto revertirá el stock si no hay cobros registrados.')">
                        <button class="btn btn-outline-danger" type="submit">Anular</button>
                    </form>
                }
                else
                {
                    <span class="badge bg-danger align-self-center">ANULADA</span>
                }
            </div>
        </div>

        <div class="card-body">
            <!-- Cabecera -->
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="border rounded p-2 h-100">
                        <div class="fw-bold mb-1">Cliente</div>
                        <div>@Model.Factura.Cliente?.NombreRazonSocial</div>
                        <div class="text-muted small">@Model.Factura.Cliente?.TipoDocumento @Model.Factura.Cliente?.NumeroDocumento</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-2 h-100">
                        <div class="fw-bold mb-1">Almacén</div>
                        <div>@Model.Factura.Almacen?.Nombre</div>
                        <div class="text-muted small">@Model.Factura.Almacen?.Direccion</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-2 h-100">
                        <div class="fw-bold mb-1">Condición de pago</div>
                        <div>@(Model.Factura.CondicionPago?.Nombre ?? "Contado")</div>
                        <div class="text-muted small">Estado: @Model.Factura.Estado</div>
                    </div>
                </div>
            </div>

            <!-- Líneas -->
            <div class="table-responsive table-scroll mb-3">
                <table class="table table-striped table-hover align-middle m-0 table-sticky">
                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th>Producto</th>
                            <th class="text-end">Cant.</th>
                            <th class="text-end">Precio</th>
                            <th class="text-end">Imp. %</th>
                            <th class="text-end">Neto</th>
                            <th class="text-end">Impuesto</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Lineas)
                        {
                            <tr>
                                <td>@l.Producto?.Sku</td>
                                <td>@l.Producto?.NombreProducto</td>
                                <td class="text-end">@l.Cantidad</td>
                                <td class="text-end">@l.PrecioUnitario.ToString("C")</td>
                                <td class="text-end">@((l.ImpuestoPorcentaje ?? 0m).ToString("0.##"))</td>
                                <td class="text-end">@l.ImporteNeto.ToString("C")</td>
                                <td class="text-end">@l.ImporteImpuesto.ToString("C")</td>
                                <td class="text-end">@l.ImporteTotal.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Resumen -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="border rounded p-3">
                        <div class="text-muted small">Subtotal</div>
                        <div class="fs-5">@Model.Factura.Subtotal.ToString("C")</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3">
                        <div class="text-muted small">Impuestos</div>
                        <div class="fs-5">@Model.Factura.TotalImpuestos.ToString("C")</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3">
                        <div class="text-muted small">Total</div>
                        <div class="fs-4 fw-bold">@Model.Factura.Total.ToString("C")</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-3">
                        <div class="text-muted small">Saldo</div>
                        <div class="fs-4 fw-bold @(Model.Saldo == 0 ? "text-success" : "text-danger")">
                            @Model.Saldo.ToString("C")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cobros -->
            <h5 class="mb-2">Cobros</h5>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Medio</th>
                            <th>Referencia</th>
                            <th class="text-end">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Cobros.Any())
                        {
                            foreach (var c in Model.Cobros)
                            {
                                <tr>
                                    <td>@c.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@c.MedioPago</td>
                                    <td>@(string.IsNullOrWhiteSpace(c.Referencia) ? "—" : c.Referencia)</td>
                                    <td class="text-end">@c.Monto.ToString("C")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">Sin cobros registrados.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal: Registrar cobro -->
    <div class="modal fade" id="modalCobro" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="AddCobro" asp-route-id="@Model.Factura!.Id">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Registrar cobro</h5>
                        <button class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2">
                            <label for="Fecha" class="form-label">Fecha</label>
                            <input class="form-control" id="Fecha" name="Fecha" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <div class="mb-2">
                            <label for="MedioPago" class="form-label">Medio de pago</label>
                            <input class="form-control" id="MedioPago" name="MedioPago" placeholder="Efectivo, Tarjeta, Transferencia..." />
                        </div>
                        <div class="mb-2">
                            <label for="Referencia" class="form-label">Referencia</label>
                            <input class="form-control" id="Referencia" name="Referencia" placeholder="#voucher / #transacción (opcional)" />
                        </div>
                        <div class="mb-2">
                            <label for="Monto" class="form-label">Monto</label>
                            <input class="form-control" id="Monto" name="Monto" type="number" min="0" step="0.01" />
                            <div class="form-text">Saldo actual: @Model.Saldo.ToString("C")</div>
                            <span class="text-danger">@Model.ErrorCobro</span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" data-bs-dismiss="modal" type="button">Cancelar</button>
                        <button class="btn btn-success" type="submit">Guardar cobro</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
